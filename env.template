# ============================================
# BotMark — قالب ملف إعدادات البوت
# انسخه إلى ملف باسم .env واملأ القيم، أو اختر
# ملف .env جاهزاً لديك عبر:  botmark setup
# ============================================

# ---- تيليجرام (مطلوب) ----
# توكن البوت من @BotFather
TELEGRAM_BOT_TOKEN=
# معرّفات المستخدمين المسموح لهم (اختياري — يُضاف تلقائياً عند أول رسالة)
TELEGRAM_ALLOWED_USER_IDS=

# ---- قاعدة البيانات (Supabase) — بيانات الاتصال بقاعدة البيانات ----
SUPABASE_URL=
SUPABASE_KEY=

# ---- يوتيوب (Google OAuth) — لرفع الفيديوهات ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/

# ---- كوكيز يوتيوب (اختياري لكنه يرفع نسبة نجاح التنزيل) ----
YTDLP_COOKIES_B64=
YTDLP_COOKIES_PATH=

# ---- أخرى (اختيارية) ----
INSTANCE_ID=local_pc
# RUN_ONLY_ON_WIFI=false
# RUN_ONLY_WHILE_CHARGING=false
