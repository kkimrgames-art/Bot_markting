async def schedule_save(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """ط­ظپط¸ ط§ظ„ط¬ط¯ظˆظ„ ط§ظ„ط¬ط¯ظٹط¯"""
    query = update.callback_query
